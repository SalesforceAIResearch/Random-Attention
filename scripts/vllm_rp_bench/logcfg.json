{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {"tri": {"format": "%(levelname)s %(name)s: %(message)s"}},
  "handlers": {"tristream": {"class": "logging.StreamHandler", "formatter": "tri", "stream": "ext://sys.stdout"}},
  "loggers": {"triattention": {"level": "INFO", "handlers": ["tristream"], "propagate": false}}
}
